@model IEnumerable<MaiYuHCM.Models.ScheduleAssignment>
@{
    ViewData["Title"] = "Schedules";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayDate = ViewBag.Date as DateTime? ?? DateTime.Today;
}

<div class="mt-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📅 Shift Schedules</h2>
        <a asp-action="CreateSchedule" class="btn btn-primary shadow-sm">+ Add Schedule</a>
    </div>

    <div class="alert alert-info shadow-sm border-0">
        Showing schedules for: <strong>@displayDate.ToString("yyyy-MM-dd")</strong>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Shift</th>
                        <th>Working Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="3" class="text-center py-4 text-muted">No schedules found for this date.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Employee?.Name</td>
                                <td><span class="badge bg-secondary">@item.Shift?.Name</span></td>
                                <td>@item.Shift?.StartTime - @item.Shift?.EndTime</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>