@model MaiYuHCM.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .form-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    }

    .form-control-lg {
        border-radius: 10px;
        border: 2px solid #e9ecef;
    }

        .form-control-lg:focus {
            border-color: #f6ad55;
            box-shadow: none;
        }

    .btn-warning-custom {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
    }
</style>

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card form-card">
            <div class="card-header bg-white border-0 pt-4 text-center">
                <h3 class="fw-bold text-dark">Edit Employee</h3>
                <p class="text-muted">Update the information for @Model.Name.</p>
            </div>
            <div class="card-body px-5 pb-5">
                <form action="/HCM/EditEmployee" method="post">
                    <!-- 必须有 Id 才能更新 -->
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" value="@Model.Name" class="form-control form-control-lg" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">Store / Factory</label>
                        <input type="text" name="StoreOrFactory" value="@Model.StoreOrFactory" class="form-control form-control-lg" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">Position</label>
                        <input type="text" name="Position" value="@Model.Position" class="form-control form-control-lg" />
                    </div>
                    <div class="form-check form-switch mb-5">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <label class="form-check-label fw-bold text-muted">Employee is currently Active</label>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-warning-custom btn-lg text-white">Update Info</button>
                        <a href="/HCM/Employees" class="btn btn-light btn-lg text-muted" style="border-radius: 10px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>