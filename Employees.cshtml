@model IEnumerable<MaiYuHCM.Models.Employee>
@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background-color: #f4f6f9; }
    .card-custom { border: none; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .table-custom th { border-top: none; font-weight: 600; color: #6c757d; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; }
    .table-custom td { vertical-align: middle; padding: 1rem 0.75rem; }
    .btn-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white; border-radius: 10px; padding: 10px 20px; font-weight: 600; transition: 0.3s; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(118,75,162,0.4); color: white; }
    .avatar { width: 40px; height: 40px; border-radius: 50%; background: #e0e7ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 10px; }
</style>

<div class="container mt-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">👥 Employee Directory</h2>
        <!-- 原生 href 绝对能跳转 -->
        <a href="/HCM/CreateEmployee" class="btn btn-gradient">+ Add New Employee</a>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-body p-3">
            <form action="/HCM/Employees" method="get" class="d-flex">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control form-control-lg bg-light border-0 me-2" placeholder="Search name or store..." style="border-radius: 10px;" />
                <button type="submit" class="btn btn-dark px-4" style="border-radius: 10px;">Search</button>
            </form>
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-body p-0">
            <table class="table table-hover table-custom mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Store / Factory</th>
                        <th>Position</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar">@item.Name.Substring(0, 1)</div>
                                    <span class="fw-bold text-dark">@item.Name</span>
                                </div>
                            </td>
                            <td><span class="text-muted">@item.StoreOrFactory</span></td>
                            <td>@item.Position</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="/HCM/EditEmployee/@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Edit</a>
                                <form action="/HCM/ToggleStatus/@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>